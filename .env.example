# Copy to .env.local and fill in the values

# Claude API (Sonnet 4.6)
ANTHROPIC_API_KEY=

# Convex (set automatically by `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Telegram Bot — get from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Nia (host sponsor) — sign up at trynia.ai
NIA_API_KEY=

# Tensorlake — get key at tensorlake.ai
TENSORLAKE_API_KEY=

# Path to your Obsidian vault (local)
OBSIDIAN_VAULT_PATH=/home/andrii/Documents/Obsidian Vault
